{
  "name": "Lead Intake & Routing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1f4c9d2-1111-4a01-9c01-000000000001",
      "name": "Webhook — New Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "lead-intake"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Validate + normalize the incoming lead\nconst body = $json.body ?? $json;\nconst errors = [];\n\nconst name = (body.name ?? '').toString().trim();\nconst email = (body.email ?? '').toString().trim().toLowerCase();\nconst message = (body.message ?? '').toString().trim();\nconst source = (body.source ?? 'website').toString().trim().toLowerCase();\n\nif (!name) errors.push('name is required');\nif (!email) errors.push('email is required');\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('email is invalid');\nif (!message) errors.push('message is required');\n\n// budget: \"$1,500\", \"1500\", \"1 500 USD\" -> 1500 (number, USD)\nlet budget = 0;\nif (body.budget !== undefined && body.budget !== null && body.budget !== '') {\n  const digits = body.budget.toString().replace(/[^0-9.]/g, '');\n  budget = digits ? Math.round(parseFloat(digits)) : 0;\n  if (Number.isNaN(budget)) budget = 0;\n}\n\nreturn {\n  json: {\n    valid: errors.length === 0,\n    errors,\n    lead: { name, email, message, source, budget, receivedAt: $now.toISO() },\n  },\n};"
      },
      "id": "a1f4c9d2-1111-4a01-9c01-000000000002",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f4c9d2-1111-4a01-9c01-000000000003",
      "name": "IF Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Score the lead: hot if budget >= 1000 USD or the message sounds urgent\nconst lead = $json.lead;\nconst urgent = /(терміново|urgent|asap|якнайшвидше)/i.test(lead.message);\nconst segment = lead.budget >= 1000 || urgent ? 'hot' : 'cold';\nreturn { json: { ...$json, lead: { ...lead, segment, urgent } } };"
      },
      "id": "a1f4c9d2-1111-4a01-9c01-000000000004",
      "name": "Score & Segment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, -80]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-hot",
              "leftValue": "={{ $json.lead.segment }}",
              "rightValue": "hot",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f4c9d2-1111-4a01-9c01-000000000005",
      "name": "IF Hot?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, -80]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#sales", "mode": "name" },
        "text": "=🔥 Гарячий лід: {{ $json.lead.name }} <{{ $json.lead.email }}> · бюджет ${{ $json.lead.budget }} · «{{ $json.lead.message }}»",
        "otherOptions": {}
      },
      "id": "a1f4c9d2-1111-4a01-9c01-000000000006",
      "name": "Notify Sales (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1100, -160],
      "credentials": { "slackApi": { "id": "cred-slack-01", "name": "QuitCode Slack" } }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "1LeadRegistrySpreadsheetId", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Leads", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "receivedAt": "={{ $json.lead.receivedAt }}",
            "name": "={{ $json.lead.name }}",
            "email": "={{ $json.lead.email }}",
            "budget": "={{ $json.lead.budget }}",
            "segment": "={{ $json.lead.segment }}",
            "source": "={{ $json.lead.source }}",
            "message": "={{ $json.lead.message }}"
          }
        },
        "options": {}
      },
      "id": "a1f4c9d2-1111-4a01-9c01-000000000007",
      "name": "Append to Leads Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1100, 20],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "cred-gsheets-01", "name": "QuitCode Google" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"segment\": $json.lead.segment } }}",
        "options": {}
      },
      "id": "a1f4c9d2-1111-4a01-9c01-000000000008",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, 20]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": false, \"errors\": $json.errors } }}",
        "options": { "responseCode": 400 }
      },
      "id": "a1f4c9d2-1111-4a01-9c01-000000000009",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 160]
    }
  ],
  "connections": {
    "Webhook — New Lead": { "main": [[{ "node": "Validate & Normalize", "type": "main", "index": 0 }]] },
    "Validate & Normalize": { "main": [[{ "node": "IF Valid?", "type": "main", "index": 0 }]] },
    "IF Valid?": {
